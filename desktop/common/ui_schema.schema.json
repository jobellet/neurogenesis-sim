{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jobellet/neurogenesis-sim/desktop/common/ui_schema.schema.json",
  "title": "neurogenesis UI schema 1.x",
  "description": "What the toolbox offers to the desktop apps (desktop/common/UI_SCHEMA.md). Unknown fields are allowed: minor versions add optional fields.",
  "type": "object",
  "required": ["format", "version", "generated_by", "project_schema_version", "param_sources", "stages", "models",
               "rule_phases", "rules", "schedule_genes"],
  "properties": {
    "format": {"const": "neurogenesis-ui-schema"},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "generated_by": {
      "type": "object",
      "required": ["toolbox", "python"],
      "properties": {"toolbox": {"type": "string"}, "python": {"type": "string"}, "date": {"type": "string"}}
    },
    "project_schema_version": {"type": "string"},
    "param_sources": {"type": "array", "items": {"$ref": "#/$defs/param_source"}},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "rule_phases": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "title", "doc"],
                "properties": {"name": {"type": "string"}, "title": {"type": "string"}, "doc": {"type": "string"}}}
    },
    "rules": {
      "type": "array",
      "items": {"type": "object", "required": ["phase", "name", "doc", "genes", "default"],
                "properties": {"phase": {"type": "string"}, "name": {"type": "string"}, "doc": {"type": "string"},
                               "genes": {"type": "array", "items": {"$ref": "#/$defs/gene_path"}},
                               "default": {"type": "boolean"}}}
    },
    "schedule_genes": {
      "type": "array",
      "items": {"type": "object", "required": ["path", "lo", "hi", "integer", "used_by"],
                "properties": {"path": {"$ref": "#/$defs/gene_path"}, "lo": {"type": "number"}, "hi": {"type": "number"},
                               "integer": {"type": "boolean"},
                               "used_by": {"type": "array", "items": {"type": "object", "required": ["stage", "param"],
                                           "properties": {"stage": {"type": "string"}, "param": {"type": "string"}}}}}}
    }
  },
  "$defs": {
    "gene_path": {
      "description": "Keys; \"src->dst\" is a projection key; integers index arrays.",
      "type": "array", "minItems": 1,
      "items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}
    },
    "param_dict": {
      "description": "An A3 param dict, e.g. {\"type\": \"Const\", \"value\": 0.1}.",
      "type": "object", "required": ["type"],
      "properties": {"type": {"type": "string"}}
    },
    "param_source": {
      "type": "object", "required": ["type", "title", "doc", "inputs"],
      "properties": {
        "type": {"type": "string"},
        "title": {"type": "string"},
        "doc": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "object", "required": ["name", "type", "doc"],
                   "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "doc": {"type": "string"}}}}
      }
    },
    "param": {
      "type": "object", "required": ["name", "title", "doc", "type", "default", "sources"],
      "properties": {
        "name": {"type": "string"},
        "title": {"type": "string"},
        "doc": {"type": "string"},
        "type": {"type": "string", "description": "float, int, bool, string, choice, vec3, geometry, field, gene_path, json (apps show unknown types as read-only JSON)"},
        "default": {"$ref": "#/$defs/param_dict"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "units": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "step": {"type": "number"},
        "choices": {"type": "array", "items": {"type": "object", "required": ["value", "title"],
                    "properties": {"title": {"type": "string"}}}},
        "per_cell": {"type": "boolean"},
        "advanced": {"type": "boolean"}
      }
    },
    "stage": {
      "type": "object",
      "required": ["operator", "title", "description", "task", "available", "params", "cost", "repeatable", "conditional"],
      "properties": {
        "operator": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "task": {"type": "string"},
        "available": {"type": "boolean"},
        "params": {"type": "array", "items": {"$ref": "#/$defs/param"}},
        "cost": {"anyOf": [
          {"type": "null"},
          {"type": "object", "required": ["declared", "samples"],
           "properties": {"declared": {"type": "boolean"},
                          "samples": {"type": "array", "items": {"type": "object", "required": ["N", "E", "bytes", "ops"],
                                      "properties": {"N": {"type": "integer", "minimum": 0}, "E": {"type": "integer", "minimum": 0},
                                                     "bytes": {"type": "number", "minimum": 0}, "ops": {"type": "number", "minimum": 0}}}}}}
        ]},
        "repeatable": {"type": "boolean"},
        "conditional": {"type": "boolean"}
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "title", "description", "substeps", "state_bytes", "flops", "cost", "native"],
      "properties": {
        "name": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "substeps": {"type": "integer", "minimum": 1},
        "state_bytes": {"type": "integer", "minimum": 0},
        "flops": {"type": "number", "minimum": 0},
        "native": {"type": "boolean"},
        "cost": {"type": "object",
                 "required": ["bytes_per_neuron", "bytes_per_synapse", "seconds_per_neuron_substep", "seconds_per_synapse_tick",
                              "seconds_per_tick_overhead", "device"],
                 "properties": {
                   "bytes_per_neuron": {"type": "number", "minimum": 0},
                   "bytes_per_synapse": {"type": "number", "minimum": 0},
                   "seconds_per_neuron_substep": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
                   "seconds_per_synapse_tick": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
                   "seconds_per_tick_overhead": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
                   "device": {"anyOf": [{"type": "string"}, {"type": "null"}]}}}
      }
    }
  }
}
