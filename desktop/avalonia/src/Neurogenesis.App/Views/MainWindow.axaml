<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neurogenesis.App.ViewModels"
        xmlns:r="using:Neurogenesis.App.Rendering"
        x:Class="Neurogenesis.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1200" Height="800"
        Background="#0E1014" Foreground="#E0E6ED"
        DragDrop.AllowDrop="True">

  <DockPanel>
    <!-- Top Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6" Spacing="8">
      <Button Content="Open NGB…" Click="OnOpen" />
      <Button Content="Reset View" Click="OnFrame" />
      <Separator Width="1" Height="20" Margin="4,0" />
      <TextBlock Text="Colour by" VerticalAlignment="Center" Margin="4,0,0,0" />
      <ComboBox ItemsSource="{Binding ColorModes}" SelectedItem="{Binding ColorMode}" MinWidth="130" />
    </StackPanel>

    <!-- Bottom Status Bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{Binding Style.UiStatusBackground}">
      <TextBlock Text="{Binding Status}" />
    </Border>

    <!-- Right Panel: Inspector -->
    <Border DockPanel.Dock="Right" Width="280" Padding="8" Background="{Binding Style.UiPanelBackground}" BorderBrush="{Binding Style.UiPanelBorder}" BorderThickness="1,0,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Inspector" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" Text="Click a neuron to show its fields." Opacity="0.6" TextWrapping="Wrap"
                   IsVisible="{Binding !HasSelection}" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Inspector}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldRow">
                <Grid ColumnDefinitions="110,*" Margin="0,1">
                  <TextBlock Text="{Binding Name}" Opacity="0.7" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Center: 3D Network View -->
    <Panel>
      <r:NetworkView x:Name="View" Scene="{Binding Scene}" Instances="{Binding Instances}" CurrentTick="{Binding CurrentTick}" />
      <TextBlock Text="{Binding SceneNote}" IsVisible="{Binding SceneNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Margin="10" Padding="6,3" Background="{Binding Style.UiNoteBackground}" Foreground="{Binding Style.UiNoteForeground}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Panel>
  </DockPanel>
</Window>
