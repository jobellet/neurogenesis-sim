<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neurogenesis.App.ViewModels"
        xmlns:r="using:Neurogenesis.App.Rendering"
        x:Class="Neurogenesis.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1280" Height="800"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button x:Name="OpenButton" Content="Open…" Click="OnOpen" HotKey="Ctrl+O" />
      <Button Content="Frame (F)" Click="OnFrame" />
      <TextBlock Text="Colour by" VerticalAlignment="Center" Margin="12,0,0,0" />
      <ComboBox x:Name="ColorModeBox" ItemsSource="{Binding ColorModes}" SelectedItem="{Binding ColorMode}" MinWidth="140" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#1A1D23">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" />
    </Border>
    <Border DockPanel.Dock="Right" Width="300" Padding="8" Background="#16191E">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Inspector" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" Text="Click a neuron to show its fields." Opacity="0.6" TextWrapping="Wrap"
                   IsVisible="{Binding !HasSelection}" />
        <ScrollViewer>
          <ItemsControl x:Name="InspectorList" ItemsSource="{Binding Inspector}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldRow">
                <Grid ColumnDefinitions="120,*" Margin="0,1">
                  <TextBlock Text="{Binding Name}" Opacity="0.7" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Panel>
      <r:NetworkView x:Name="View" Scene="{Binding Scene}" Instances="{Binding Instances}" />
      <TextBlock x:Name="NoteText" Text="{Binding SceneNote}" IsVisible="{Binding SceneNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Margin="10" Padding="6,3" Background="#B0101318" Foreground="#FFD27F"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Panel>
  </DockPanel>
</Window>
