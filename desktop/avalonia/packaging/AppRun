#!/bin/sh
set -e

HERE="$(dirname "$(readlink -f "${0}")")"

export APPDIR="${HERE}"
export PATH="${HERE}/usr/bin:${HERE}/usr/runtime/python/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${HERE}/usr/runtime/python/lib:${LD_LIBRARY_PATH}"
export NEUROGENESIS_PYTHON="${HERE}/usr/runtime/python/bin/python3"

exec "${HERE}/usr/bin/Neurogenesis" "$@"
